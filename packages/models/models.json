{
  "$schema": "./models.schema.json",
  "schemaVersion": "1.0.0",
  "note": "The single authority for generation models (plan D27, DM-1). `id`, `provider`, `provider_model`, `kind`, `capabilities`, limits and `request_shape` drive the adapters and validators; `label`, `friendlyLabel`, `help` and `icon` are the presentation layer and may be reworded freely. Costs are in pence and are estimates the adult can see; verify against the provider's price list when enabling a model. Adding a model is an edit here plus, at most, one adapter.",
  "models": [
    {
      "id": "quick_picture",
