# Copy to deploy/release.env (gitignored). Used only by `npm run release` on this PC.

# DSM user with SSH access, in the administrators group (needed for sudo docker).
NAS_USER=your-dsm-user
NAS_HOST=192.168.1.73
NAS_SSH_PORT=22

# Project folder on the NAS (the path you chose when creating the Container Manager project).
NAS_DIR=/volume1/docker/storyboard

# Compose project name as shown in Container Manager > Project. Normally detected from the
# running container's labels; set it only if detection fails or for a first-time deploy.
# NAS_PROJECT=bunnystudios

# Container Manager's engine. Leave unset if the DSM user is in the "docker" group.
# NAS_DOCKER="sudo /usr/local/bin/docker"

# Where the app answers; the release polls /health here until the new build is live.
APP_URL=http://192.168.1.73:3001

# SSH key made by `npm run release -- --setup`. Default: ~/.ssh/storyboard_nas
# NAS_KEY=C:\Users\you\.ssh\storyboard_nas
