# Copy to .env for local development. Never commit the real file (NF-20).
# In Azure these are Container Apps secrets backed by Key Vault.

NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://storyboard:localdev@localhost:5433/storyboard
CORS_ORIGINS=http://localhost:5173

# Claude API key from https://platform.claude.com/settings/keys
# Leave blank to disable AI thumbnails. This file is loaded only by the API server.
# Claude produces drawing instructions; the app renders a simple SVG scene thumbnail.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
THUMBNAIL_DAILY_LIMIT=30
THUMBNAIL_REQUESTS_PER_MINUTE=3

# ── Director Mode (docs/director-mode-plan-v1.md) ─────────────────────────
# fal.ai key from https://fal.ai/dashboard/keys (plan D28). Blank hides every fal picture maker.
FAL_KEY=
# Where generated pictures, clips and renders are written (plan D29). A NAS volume in production.
STORAGE_ROOT=./storage
# ffmpeg and ffprobe for poster frames and the final render. Full paths on Windows.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# The Claude models used to check prompts and pictures (plan D32) and to find the cast (D39).
REVIEW_MODEL=claude-sonnet-5
CAST_MODEL=claude-sonnet-5
# The in-process job runner; 'off' only when another instance runs the jobs.
GENERATION_RUNNER=on

# Any random string of 32+ chars locally; a real secret in Azure.
JWT_SECRET=change-me-to-something-long-and-random

# Plan D8 - the two v1 accounts. Generate a hash with:
#   node src/db/hash-password.ts 'your password'
AUTH_ADULT_EMAIL=you@example.com
AUTH_ADULT_DISPLAY_NAME=Your Name
AUTH_ADULT_PASSWORD_HASH=scrypt$...

AUTH_TEEN_EMAIL=creator@storyboard.local
AUTH_TEEN_DISPLAY_NAME=Creator
AUTH_TEEN_PASSWORD_HASH=scrypt$...

# Tests create disposable accounts; no real account passwords are needed.
