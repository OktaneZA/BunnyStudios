# Copy to deploy/synology/.env on the NAS. Never commit the real file (NF-20).
# Every value here reaches the container only; nothing is baked into the image.

# --- Postgres on the DiskStation (homenas.lan = 192.168.1.73, port 5400) ---
# Two roles, both created by provision.sql. Use the IP: Docker's resolver does not reliably
# answer for the .lan name, and a name lookup failure looks like a database outage.
#
# storyboard_app: what the running API uses. Data access only, cannot change the schema.
DATABASE_URL=postgres://storyboard_app:CHANGE-ME@192.168.1.73:5400/storyboard
# storyboard: owns the schema; used only by the migration step at container start.
# Leave unset to run migrations as DATABASE_URL (then that role must own the database).
MIGRATION_DATABASE_URL=postgres://storyboard:CHANGE-ME@192.168.1.73:5400/storyboard

# --- Session signing: 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING

# --- Host port published on the NAS (the container always listens on 3001 internally).
STORYBOARD_PORT=3001

# --- Browser origins allowed to call the API. When the web app is served by this same
# container (the default), same-origin requests do not need CORS, so this only matters
# if you also run the Vite dev server against the NAS. Leave as-is otherwise.
CORS_ORIGINS=http://localhost:5173

# --- The two v1 accounts (plan D8). Hashes only; make one with:
#   node apps/api/src/db/hash-password.ts 'the password'
# or, without a checkout, from the running container:
#   docker exec storyboard-studio node --experimental-strip-types apps/api/src/db/hash-password.ts 'the password'
AUTH_ADULT_EMAIL=you@example.com
AUTH_ADULT_DISPLAY_NAME=Your Name
AUTH_ADULT_PASSWORD_HASH=scrypt$...

AUTH_TEEN_EMAIL=creator@storyboard.local
AUTH_TEEN_DISPLAY_NAME=Creator
AUTH_TEEN_PASSWORD_HASH=scrypt$...

# --- Claude (optional). Blank disables AI thumbnails and "Improve"; scene editing still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
THUMBNAIL_DAILY_LIMIT=30
THUMBNAIL_REQUESTS_PER_MINUTE=3

# Set to false once you prefer to run migrations by hand.
RUN_MIGRATIONS=true
